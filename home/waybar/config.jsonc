{
  "layer": "bottom",
  "position": "top",
  "exclusive": "false",

  "modules-left": [
    "cpu",
    "custom/temp",
    "memory",
    "hyprland/workspaces"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "tray",
    "custom/cava",
    "pulseaudio",
    "custom/power"
  ],

  "pulseaudio": {
    "tooltip": false,
    "scroll-step": 5,
    "format": "{icon}  {volume}%",
    "format-muted": "muted",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    }
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10
  },

  "custom/cava": {
    "exec": "/home/celin/.config/waybar/scripts/cava.sh",
    "return-type": "text",
    "format": "{}",
    "tooltip": false
  },

  "cpu": {
    "interval": 2,
    "format": "  {usage}%",
    "max-length": 10
  },

  "custom/temp": {
    "format": " {}",
    "interval": 3,
    "exec": "/home/celin/.config/waybar/scripts/tempinfo.sh",
    "tooltip": true
  },

  "memory": {
    "format": "  {used:0.1f}GB"
  },

  "custom/launcher": {
    "format": " ",
    "on-click": "rofi -show run",
    "on-click-right": "killall rofi",
    "tooltip": false
  },

  "custom/power": {
    "format": "⏻ ",
    "tooltip": false,
    "on-click": "bash ~/.config/rofi/powermenu.sh",
    "on-click-right": "killall rofi"
  },

  "clock": {
    "locale": "en_US.UTF-8",
    "format": " {:L%a %d %b 󰥔 %H:%M}",

    "calendar": {
      "format": {
        "days": "<span weight='normal'>{}</span>",
        "months": "<span color='#ffffff'><b>{}</b></span>",
        "today": "<span color='#ff004b' weight='700'><u>{}</u></span>",
        "weekdays": "<span color='#ffffff'><b>{}</b></span>",
        "weeks": "<span color='#ffffff'><b>W{}</b></span>"
      },

      "mode": "month",
      "mode-mon-col": 1,
      "on-scroll": 1
    },

    "tooltip-format": "<span color='#cdd6f4' font='JetBrainsMono Nerd Font 18'><tt><small>{calendar}</small></tt></span>"
  },

  "hyprland/workspaces": {
    "format": "{icon} {windows}",
    "on-click": "activate",

    "persistent-workspaces": {
      "*": 5
    },

    "window-rewrite-default": "󰊠",

    "window-rewrite": {
      // --- Work ---
      "kitty": "󰆍",
      "firefox": "󰈹",
      "dev.zed.Zed": "",

      // --- Apps ---
      "vesktop": "",
      "org.qbittorrent.qBittorrent": "󰘿",
      "steam": "",
      "stremio": "",

      // --- Graphics & Visual ---
      "xdg-desktop-portal-gtk": "",
      "thunar": "",
      "mpv": "",

      // --- System ---
      "blueman-manager": "",
      "pavucontrol": "󱕂",
      "nm-connection-editor": "󰐻",

      // --- Tool ---
      "nwg-look": "󰒓",
      "qt5ct": "󰒓",
      "qt6ct": "󰒓",
      "designer": "󰒓",
      "linguist": "󰒓",
      "assistant": "󰒓",
      "pixeltool": "󰒓",
      "qdbusviewer": "󰒓"
    },

    "format-icons": {
      "active": "󰮯",
      "special": "󱁂",
      "default": "󰊠",
      "urgent": "󰧵",
      "empty": ""
    },

    "show-special": true,
    "all-outputs": true
  }
}
