{
  "layer": "bottom",
  "position": "top",
  "exclusive": true,

  "modules-left": [
    "hyprland/workspaces",
    "custom/cava",
    "custom/network-speed"

  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "tray",
    "pulseaudio",
    "memory",
    "cpu",
    "custom/temp",
    "custom/power"
  ],

  "pulseaudio": {
    "tooltip": false,
    "scroll-step": 5,
    "format": "{icon}  {volume}%",
    "format-muted": "muted",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    }
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10
  },

  "custom/network-speed": {
    "exec": "\"${XDG_CONFIG_HOME:-$HOME/.config}/waybar/scripts/network-speed.sh\"",
    "return-type": "json",
    "format": "{text}",
    "interval": 2,
    "tooltip": true,
  },

  "custom/cava": {
    "exec": "\"${XDG_CONFIG_HOME:-$HOME/.config}/waybar/scripts/cava.sh\"",
    "return-type": "text",
    "format": "{}",
    "tooltip": false,
    "interval":0
  },

  "cpu": {
    "interval": 2,
    "format": "  {usage}%",
    "max-length": 10
  },

  "custom/temp": {
    "format": " {}",
    "interval": 2,
    "exec": "\"${XDG_CONFIG_HOME:-$HOME/.config}/waybar/scripts/tempinfo.sh\"",
    "tooltip": false,
  },

  "memory": {
    "interval":3,
    "tooltip": false,
    "format": " {used:0.1f}GB"
  },

  "custom/launcher": {
    "format": " ",
    "on-click": "rofi -show drun",
    "tooltip": false,
  },

  "custom/power": {
    "format": "⏻ ",
    "tooltip": false,
    "on-click": "bash \"${XDG_CONFIG_HOME:-$HOME/.config}/rofi/powermenu.sh\"",
  },

  "clock": {
    "tooltip": true,
    "locale": "en_US.UTF-8",
    "format": " {:L%a %d %b 󰥔 %H:%M}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "today": "<span foreground='#000000' background='#ffffff'><b>{}</b></span>",
      },
    },
    "actions": {
      "on-click-left": "shift_reset",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
      "on-click-right": "mode",
    },
  },

  "hyprland/workspaces": {
    "tooltip": false,
    "format": "{icon} {windows}",

    "persistent-workspaces": {
      "*": 5
    },

    "window-rewrite-default": "󰟢",

    "window-rewrite": {
      // --- Work ---
      "kitty": "",
      "brave-origin":"󰖟",
      "Chatgpt": "󰚩",

      // --- Apps ---
      "discord": "",
      "com.github.wwmm.easyeffects": "󰺢",
      "org.qbittorrent.qBittorrent": "󰘿",
      "steam": "",
      "stremio": "",
      "org.prismlauncher.PrismLauncher": "󰍳",
      "Minecraft": "󰍳",
      "com.github.th-ch.youtube-music": "",
      "net.lutris.Lutris":"",

      // --- Graphics & Visual ---
      "xdg-desktop-portal-gtk": "",
      "thunar": "",
      "mpv": "",

      // --- System ---
      "blueman-manager": "",
      "pavucontrol": "󱕂",
      "nm-connection-editor": "󰐻",

      // --- Tool ---
      "nwg-look": "󰒓",
      "qt5ct": "󰒓",
      "qt6ct": "󰒓",
      "designer": "󰒓",
      "linguist": "󰒓",
      "assistant": "󰒓",
      "pixeltool": "󰒓",
      "qdbusviewer": "󰒓",
      "io.github.ilya_zlobintsev.LACT":"󰒓"
    },

    "format-icons": {
      "active": "",
      "special": "󱁂",
      "default": "",
      "urgent": "",
      "empty": ""
    },

    "show-special": true,
    "all-outputs": true
  }
}
