{
  "layer": "bottom",
  "position": "top",
  "exclusive": true,

  "modules-left": [
    "hyprland/workspaces",
    "custom/window"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "tray",
    "pulseaudio",
    "memory",
    "cpu",
    "custom/temp",
    "custom/power"
  ],

"custom/window": {
    "tooltip": false,
    "exec": "~/.config/waybar/scripts/window.sh",
    "format": "{}"
    
},

  "pulseaudio": {
    "tooltip": false,
    "scroll-step": 5,
    "format": "{icon}  {volume}%",
    "format-muted": "muted",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    }
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10
  },

  "custom/cava": {
    "exec": "/home/celin/.config/waybar/scripts/cava.sh",
    "return-type": "text",
    "format": "{}",
    "tooltip": false,
  },

  "cpu": {
    "interval": 2,
    "format": "  {usage}%",
    "max-length": 10
  },

  "custom/temp": {
    "format": " {}",
    "interval": 2,
    "exec": "/home/celin/.config/waybar/scripts/tempinfo.sh",
    "tooltip": false,
  },

  "memory": {
    "interval":3,
    "tooltip": false,
    "format": " {used:0.1f}GB"
  },

  "custom/launcher": {
    "format": " ",
    "on-click": "rofi -show drun",
    "tooltip": false,
  },

  "custom/power": {
    "format": "⏻ ",
    "tooltip": false,
    "on-click": "bash ~/.config/rofi/powermenu.sh",
  },

  "clock": {
    "tooltip":false,
    "locale": "en_US.UTF-8",
    "format": " {:L%a %d %b 󰥔 %H:%M}",
  },

  "hyprland/workspaces": {
    "tooltip": false,
    "format": "{icon} {windows}",

    "persistent-workspaces": {
      "*": 5
    },

    "window-rewrite-default": "",

    "window-rewrite": {
      // --- Work ---
      "kitty": "",
      "brave-origin":"󰖟",

      // --- Apps ---
      "discord": "",
      "org.qbittorrent.qBittorrent": "󰘿",
      "steam": "",
      "stremio": "",
      "org.prismlauncher.PrismLauncher": "󰍳",
      "Minecraft": "󰍳",
      "com.github.th-ch.youtube-music": "",
      "net.lutris.Lutris":"",

      // --- Graphics & Visual ---
      "xdg-desktop-portal-gtk": "",
      "thunar": "",
      "mpv": "",

      // --- System ---
      "blueman-manager": "",
      "pavucontrol": "󱕂",
      "nm-connection-editor": "󰐻",

      // --- Tool ---
      "nwg-look": "󰒓",
      "qt5ct": "󰒓",
      "qt6ct": "󰒓",
      "designer": "󰒓",
      "linguist": "󰒓",
      "assistant": "󰒓",
      "pixeltool": "󰒓",
      "qdbusviewer": "󰒓",
      "io.github.ilya_zlobintsev.LACT":"󰒓"
    },

    "format-icons": {
      "active": "",
      "special": "󱁂",
      "default": "",
      "urgent": "",
      "empty": ""
    },

    "show-special": true,
    "all-outputs": true
  }
}
