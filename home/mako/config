# ===============================
# Mako - configuração visual
# ===============================

# Posição na tela
anchor=top-right
layer=overlay

# Margens
margin=10
padding=12

# Tamanho
width=340
height=110
max-visible=3

# Fonte
font=Inter 12

# Cores (formato ARGB)
background-color=#000000CC
text-color=#ffffff
border-color=#ffffffff

# Borda
border-size=2
border-radius=16

# Tempo na tela (ms)
default-timeout=3500
ignore-timeout=false

# Ícones
icons=1
icon-path=/usr/share/icons/hicolor


