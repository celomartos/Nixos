/* MACOS LAUNCHPAD LIKE THEME FOR ROFI */
/* Author: Newman Sanchez (https://github.com/newmanls) */

* {
    font: "JetBrainsMono Nerd Font 12";

    bg0:  #00000099;
    bg1:  #363636;
    bg2:  #f5f5f520;
    bg3:  #f5f5f540;
    bg4:  #ffffff20;

    fg0:  #ffffff;
    fg1:  #f5f5f580;

    background-color: transparent;
    text-color:       @fg0;
    padding:          0px;
    margin:           0px;
}

window {
  fullscreen: true;
  padding: 1em;
  background-color: @bg0;
  location: north;      /* Ancora a janela no topo da tela */
  anchor:   north;      /* O ponto de ancoragem do Rofi também é o topo */
  y-offset: 32px;       /* A altura da sua barra + uma margem de respiro */
}

mainbox {
  padding:  8px;
}

inputbar {
  background-color: @bg2;

  margin:   0px calc( 50% - 150px );
  padding:  4px 8px;
  spacing:  4px;

  border:         1px;
  border-radius:  8px;
  border-color:   @bg3;

  children: [icon-search,entry];
}

prompt {
  enabled:  false;
}

icon-search {
  expand:   false;
  filename: "search";
  vertical-align: 0.5;
}

entry {
  placeholder:        "Search";
  placeholder-color:  @fg1;
}

listview {
  margin:   48px calc( 50% - 560px );
  spacing:  40px;
  columns:  6;
  fixed-columns: true;
}

element, element-text, element-icon {
  cursor: pointer;
}

element {
  padding:      8px;
  spacing:      4px;

  orientation:    vertical;
  border-radius:  16px;
}

element selected {
  background-color: @bg4;
  border: 1px;
  border-color: #ffffff80;
  border-radius: 16px;
}

element-icon {
  size: 4em;
  horizontal-align: 0.5;
}

element-text {
  horizontal-align: 0.5;

  /* --- Sombra/contorno simulado (Sintaxe Rofi) --- */
  background-color: #111111B3;
  border:           2px;
  border-color:     #111111B3;
  border-radius:    6px;
  padding:          1px 6px;
  /* ----------------------------------------------- */
}
