configuration {
    modi: "drun,filebrowser";
    show-icons: true;
    //icon-theme: "";
    terminal: "kitty";
    drun-display-format: "{name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    kb-cancel: [ Escape, MousePrimary, MouseSecondary ];
    me-select-entry: "";
    me-accept-entry: [ MousePrimary, MouseSecondary, MouseDPrimary ];
    hover-select: true;
    ml-row-up: "";
    ml-row-down: "";

    drun-exclude-categories: "Settings;System;AudioVideo;Audio;";
    drun-show-actions: false;
    drun-use-desktop-cache: false;
}
@theme "~/.config/rofi/theme.rasi"
